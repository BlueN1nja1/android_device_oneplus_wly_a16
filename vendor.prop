# Bluetooth
bluetooth.device.default_name=OnePlus 10 Pro 5G

# Graphics
ro.surface_flinger.set_idle_timer_ms=4000
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.use_smart_90_for_video=true
vendor.display.disable_hw_recovery=1
vendor.display.enable_null_display=0
vendor.display.enable_compute_allocator=0
debug.sf.disable_client_composition_cache=1
debug.egl.hw=1
debug.sf.hw=1
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.use_color_management=true
vendor.display.disable_cont_splash=1
vendor.display.vblank_wait=1
ro.vendor.perf.scroll_opt=0
vendor.display.color_manage_enable=1
vendor.display.enable_default_color_mode=1
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.use_color_management=true
ro.surface_flinger.latch_presentation_time_offset_ms=10
debug.sf.frame_rate_multiple=120

# Radio
persist.radio.multisim.config=dsds

# USB
vendor.usb.product_string=OnePlus 10 Pro 5G
