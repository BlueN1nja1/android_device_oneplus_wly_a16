# ==============================================================================
# wly Thermal & Performance Profiles
# ==============================================================================

on boot
    # We MUST let the X2 and Mid cores completely power off to save voltage
    write /sys/devices/system/cpu/cpu4/core_ctl/enable 1
    write /sys/devices/system/cpu/cpu7/core_ctl/enable 1

    # Delay the ramp-up (up_rate_limit) so background tasks don't cause heat spikes.
    # Increase the down-ramp (down_rate_limit) so UI feels smooth once it's fast.
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us 1000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us 2000

    # Drop idle timer from 64ms to 50ms. GPU will sleep faster after a frame is drawn.
    write /sys/class/kgsl/kgsl-3d0/idle_timer 50
    write /sys/class/devfreq/soc:qcom,cpu-cpu-llcc-bw/governor "bw_hwmon"
    write /sys/class/devfreq/soc:qcom,cpu-llcc-ddr-bw/governor "bw_hwmon"

    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/swappiness 60

    # Disable verbose kernel logging to reduce I/O heat
    stop oplus_log
    stop log_main
    stop log_system
    write /proc/sys/kernel/printk "3 4 1 3"


# ------------------------------------------------------------------------------
# PROFILE 1: DEVELOPMENT / ADB TETHERED (Max Thermal Protection)
# ------------------------------------------------------------------------------
on property:sys.usb.state=*adb*
    # Park the X2 completely. You don't need the Prime core for compiling/testing via adb.
    write /sys/devices/system/cpu/cpu7/online 0

    # Cap Mid cores to an efficient 2.0GHz
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2000000

    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 3
    write /dev/cpuctl/background/cpu.uclamp.max 10


# ------------------------------------------------------------------------------
# PROFILE 2: DAILY DRIVING (Cool & Efficient 120Hz)
# ------------------------------------------------------------------------------
on property:sys.usb.state=mtp && property:sys.performance.profile=0

    # Allow X2 to wake up, but cap it at the efficiency cliff (2.4GHz)
    write /sys/devices/system/cpu/cpu7/online 1
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 2496000

    # Unlock Mid cores
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2496000

    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 2
    write /dev/cpuctl/background/cpu.uclamp.max 20


# ------------------------------------------------------------------------------
# PROFILE 3: GAMING (Unleashed Performance)
# ------------------------------------------------------------------------------
on property:sys.performance.profile=1

    # Unlock everything
    write /sys/devices/system/cpu/cpu7/online 1
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 2995200
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2496000

    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 0
    write /dev/cpuctl/background/cpu.uclamp.max 30
