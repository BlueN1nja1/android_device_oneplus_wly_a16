# Allow composer to read/write the Oplus topology socket
allow hal_graphics_composer_default vendor_notify-topology_socket:sock_file rw_file_perms;
allow hal_graphics_composer_default tee_device:chr_file rw_file_perms;

# Allow composer to connect to the qseecom daemon
allow hal_graphics_composer_default tee:unix_stream_socket connectto;
